# Copy to .env (git-ignored). Part 1, the tool demo and the tests need no key.
OPENAI_API_KEY=
# A tool-capable OpenAI model. The saved demos used gpt-5.6-luna.
MODEL_NAME=gpt-5.6-luna
# gpt-5.6-luna only allows tool calls in Chat Completions with reasoning effort "none".
# Leave empty to not send the parameter (for models that do not support it).
MODEL_REASONING_EFFORT=none
# Memory (conversation checkpoints + user preferences). Keep it out of git.
HELPDESK_STORAGE_DIR=local-storage
# Where `python -m helpdesk chat` saves ticket drafts (the scenario runner uses outputs/tickets/<scenario>/).
HELPDESK_TICKET_DIR=local-storage/tickets
# Keep external tracing disabled for this local exercise.
LANGSMITH_TRACING=false
